  "sequences": [
    {
      "id": "history-before-audio",
      "events": [
        "setup-history",
        "setup-complete",
        "history-final",
        "input-48000"
      ],
      "expectation": "History must not generate a reply or replay work."
    },
    {
      "id": "delayed-input-and-duplicate-call",
      "events": [
        "call",
        "output-text",
        "input-text",
        "call",
        "result-when-idle",
        "turn-complete"
      ],
      "expectation": "Execute once; turn completion is not a result ack."
    },
    {
      "id": "cancel-before-result",
      "events": [
        "call",
        "cancel"
      ],
      "expectation": "Clean up local work; suppress the cancelled result."
    },
    {
      "id": "cancel-after-send",
      "events": [
        "call",
        "result-when-idle",
        "cancel"
      ],
      "expectation": "Delivery remains uncertain; do not resend or undo."
    },
    {
      "id": "interrupted-output",
      "events": [
        "output-text",
        "audio",
        "interrupted",
        "turn-complete"
      ],
      "expectation": "Flush playback without requiring generationComplete."
    },
    {
      "id": "go-away-during-work",
      "events": [
        "call",
        "go-away"
      ],
      "expectation": "Terminal cleanup, not reconnect or idle wake."
    },
    {
      "id": "repeated-transcript",
      "events": [
        "input-repeat",
        "input-repeat",
        "output-text",
        "output-leading-space",
        "generation-complete",
        "turn-complete"
      ],
      "expectation": "Retain exact text; equal strings are not duplicate IDs."
    }
  ]
